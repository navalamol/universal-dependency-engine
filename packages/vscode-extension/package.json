{
  "name": "mendfix-vscode",
  "displayName": "MendFix",
  "description": "Automated vulnerability remediation — Mend · Snyk · Dependabot · npm-audit and more",
  "version": "0.1.0",
  "publisher": "mendfix",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["security", "vulnerabilities", "mend", "snyk", "dependabot", "npm", "maven"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mendfix",
          "title": "MendFix",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mendfix": [
        {
          "type": "webview",
          "id": "mendfix.panel",
          "name": "MendFix"
        }
      ]
    },
    "commands": [
      {
        "command": "mendfix.openPanel",
        "title": "MendFix: Open Panel"
      },
      {
        "command": "mendfix.analyzeReport",
        "title": "MendFix: Analyze Vulnerability Report"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mendfix.analyzeReport",
          "when": "resourceExtname == .json",
          "group": "mendfix"
        }
      ]
    },
    "configuration": {
      "title": "MendFix",
      "properties": {
        "mendfix.outDir": {
          "type": "string",
          "default": "./mendfix-output",
          "description": "Directory for remediation output files (overrides, reports, graph-diff)."
        },
        "mendfix.verifyVersions": {
          "type": "boolean",
          "default": false,
          "description": "Check npm registry for version existence before recommending. Slower but more accurate."
        }
      }
    }
  },
  "scripts": {
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0"
  }
}
