{
  "name": "mend-autofixer",
  "version": "1.0.0",
  "description": "Automate resolution of Mend security vulnerability reports for Node.js projects",
  "main": "mend-fix.js",
  "bin": {
    "mend-fix": "./mend-fix.js"
  },
  "scripts": {
    "start": "node mendfix.js",
    "analyze": "node mendfix.js analyze",
    "apply": "node mendfix.js apply",
    "renovate": "node mendfix.js renovate",
    "test": "node mendfix.js analyze --report ../GH_ui-platform_dev-vulnerability-report.json"
  },
  "dependencies": {
    "semver": "^7.7.1",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=16"
  }
}
